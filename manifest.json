{
  "manifest_version": 3,
  "name": "X Account Filter",
  "version": "1.0.0",
  "description": "Xでbotアカウントや信頼性の低い情報を繰り返す投稿者をフィルタリング",

  "permissions": [
    "storage",
    "tabs",
    "scripting",
    "contextMenus"
  ],

  "host_permissions": [
    "https://x.com/*",
    "https://twitter.com/*"
  ],

  "background": {
    "service_worker": "src/background/background.js"
  },

  "content_scripts": [
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*"
      ],
      "js": [
        "src/content/analyzer.js",
        "src/content/domParser.js",
        "src/content/filterEngine.js",
        "src/content/main.js"
      ],
      "css": [
        "src/content/styles.css"
      ],
      "run_at": "document_idle"
    }
  ],

  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "X Account Filter",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },

  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "web_accessible_resources": [
    {
      "resources": ["src/content/styles.css"],
      "matches": ["https://x.com/*", "https://twitter.com/*"]
    }
  ]
}
